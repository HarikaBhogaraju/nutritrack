# Copy this to .env and fill in real values.

# SQLite for local dev. Swap to Postgres in prod, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nutritrack
DATABASE_URL=sqlite:///./nutritrack.db

# Random long string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=10080

# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which Claude model to use for chat + vision
CLAUDE_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173
